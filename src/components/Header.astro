---
import { Image } from 'astro:assets';
import { SITE } from '~/consts';
import fmLogo from '~/assets/fm1-logo.png';
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <Image src={fmLogo} alt="" width={28} densities={[1, 2, 3]} class="brand-mark" loading="eager" />
      <span class="brand-name">{SITE.title}</span>
    </a>
    <nav aria-label="Primary">
      <a href="/">Posts</a>
      <a href="https://focusmode.one" rel="noopener">Focus Mode One →</a>
    </nav>
  </div>
</header>
